NODE_ENV=development
PORT=3000

# Local development outside Docker uses localhost.
DATABASE_URL=postgresql://kb_user:change_this_postgres_password@localhost:5432/knowledge_base

# If the server runs inside Docker Compose, use this host instead:
# DATABASE_URL=postgresql://kb_user:change_this_postgres_password@postgres:5432/knowledge_base

JWT_SECRET=change_this_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=20d
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
# Comma-separated allowed browser origins. Use the deployed URL in production, for example http://localhost:8080.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

POSTGRES_USER=kb_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=knowledge_base

# Production web container host port.
WEB_PORT=8080
# Optional host directory containing fullchain.pem and privkey.pem for HTTPS.
HTTPS_CERT_DIR=./docker/nginx/certs

# Initial admin user used by pnpm --filter server db:seed or docker compose exec server pnpm --filter server db:seed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_DISPLAY_NAME=管理员
