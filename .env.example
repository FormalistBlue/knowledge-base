NODE_ENV=development
PORT=3000

# Local development outside Docker uses localhost.
DATABASE_URL=postgresql://kb_user:kb_password@localhost:5432/knowledge_base

# If the server runs inside Docker Compose, use this host instead:
# DATABASE_URL=postgresql://kb_user:kb_password@postgres:5432/knowledge_base

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=20d
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=100

POSTGRES_USER=kb_user
POSTGRES_PASSWORD=kb_password
POSTGRES_DB=knowledge_base
